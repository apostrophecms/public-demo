# ApostropheCMS Environment Variables
# Copy this file to .env and fill in your values.

# Set to 1 to rebuild the admin UI on every restart. Without it, the admin UI
# is only rebuilt when dependencies change. Useful when customizing admin UI
# components in a project's ui/apos/ folders.
# APOS_DEV=1

# Database connection URI. Apostrophe defaults to MongoDB but also supports
# SQLite and PostgreSQL via the @apostrophecms/db-connect adapter.
# The backend used is determined by the URI protocol — no code changes needed.
#
# MongoDB:
# APOS_DB_URI=mongodb://localhost:27017/public-demo
#
# SQLite (no server required, good for local dev):
# APOS_DB_URI=sqlite://./data/public-demo.db
#
# PostgreSQL (note: use underscores, not hyphens, in the database name):
# APOS_DB_URI=postgres://user:password@localhost:5432/public_demo
